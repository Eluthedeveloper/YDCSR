# Copy this file to .env and fill in your values before running docker-compose up

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_USER=ydcs
DB_PASSWORD=change_me_db_password
DB_NAME=ydcs_radio_home

# JWT secrets - generate with: openssl rand -base64 64
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies - leave empty if frontend and API are on the same domain (default Docker setup)
COOKIE_DOMAIN=

# CORS - only needed if frontend is served from a different origin
CORS_ORIGIN=http://localhost

# Uploads
MAX_FILE_SIZE=5242880

# Backups (cron expression, or "off" to disable)
BACKUP_CRON=off

# Swagger UI in production
ENABLE_SWAGGER=false

# Host port for the frontend (Nginx)
FRONTEND_PORT=80
